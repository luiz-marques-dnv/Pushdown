Sub test()
    Dim thisScenario As ScenarioType
    Dim filePath As String
    Dim outputFile As Integer
    Dim i As Integer
    Dim row As Integer
    Dim workingDirectory As String
    Dim scenarioName As String
    Dim programName As Integer
    Dim Name As String
    Dim timeSpent As Double
    
    ' Set up test parameters
    AuxMacros.setCurrentFolder
    
    ' Define the file path where you want to save the output
    filePath = "C:\Users\LUIMAR\Desktop\output.txt" ' Change this to your desired file path
    
    ' Open the file for output
    outputFile = FreeFile
    Open filePath For Append As outputFile
    
    For i = 0 To 1000
        
        row = i Mod 8 + 2
        
        thisScenario = InitScenariosAttributes(row)
        
        workingDirectory = thisScenario.FolderPath ' Set this to a valid directory on your system
        scenarioName = thisScenario.Name
        
        programName = i Mod 4
        
        Select Case programName
            Case 0
                Name = "Fahts"
            Case 1
                Name = "Usfos"
            Case 2
                Name = "Strain"
            Case 3
                Name = "Strain Neg"
        End Select
        
        ' Call the ExecuteProgram subroutine
        timeSpent = ExecuteProgramDebug(programName, workingDirectory, scenarioName)
        
        ' Write the output to the text file
        Print #outputFile, Name & "," & timeSpent
        
    Next i
    
    ' Close the file
    Close outputFile
End Sub

