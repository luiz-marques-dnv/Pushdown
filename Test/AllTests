Sub test_change()
    Dim filePath As String
    Dim PreviousTimestamp As String
    Dim HasChanged As Boolean
    
    
    
    ' Set the file path
    filePath = "D:\LUIMAR\PUSHDOWN\Testes\TS063\Teste Planilha V4 All steps\21_L06_seg_TS063_L_Pool_P1\L06_seg_TS063_L_Pool_P1_output_beltemp.fem"
    
    ' Get the initial timestamp
    PreviousTimestamp = GetFileLastModified(filePath)
    
    ' Check if the file has changed
    HasChanged = CheckFileChange(filePath, PreviousTimestamp)
    
    ' Display the result
    If HasChanged Then
        MsgBox "The file has changed"
    Else
        MsgBox "The file has not changed"
    End If
End Sub

